{
  "name": "ddd-for-windows",
  "version": "1.0.0",
  "description": "ddd for Windows - A graphical debugger frontend for GDB",
  "main": "dist-electron/main.js",
  "repository": "https://github.com/xiaoshaoning/ddd",
  "author": "Xiao, Shaoning",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:electron": "node scripts/dev-electron.js",
    "build": "tsc && vite build",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "npx playwright test --reporter=list",
    "test:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "monaco-editor": "^0.44.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "optionalDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ddd-for-windows.app",
    "productName": "ddd for Windows",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
